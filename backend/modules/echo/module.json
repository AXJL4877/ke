{
  "id": "echo",
  "name": "回声示例",
  "description": "壳自带示例模块：原样返回参数；消息填 __fail__ 可演示执行节点报错",
  "version": "1.0.0",
  "category": "system",
  "input_schema": {
    "message": {
      "type": "string",
      "format": "textarea",
      "required": true,
      "label": "消息",
      "description": "原样回显；用于验证 DynamicForm textarea",
      "default": "hello"
    }
  },
  "output_schema": {
    "echo": {
      "type": "string"
    }
  },
  "ui_hint": {
    "form_layout": "vertical",
    "icon": "message",
    "hidden": true
  },
  "runtime": {
    "async": false,
    "timeout_seconds": 30
  },
  "capabilities": [
    {
      "id": "echo-roundtrip",
      "desc": "原样回显 message；壳自带验收用，业务项目可忽略",
      "kind": "core",
      "must_keep": true,
      "endpoints": [],
      "verify": { "manual": "提交 message=hello 应返回 echo=hello" }
    }
  ]
}
