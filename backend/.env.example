# Copy to .env and adjust. All keys use KE_ prefix.
KE_DATABASE_URL=sqlite:///./data/ke.db
KE_REDIS_URL=redis://localhost:6379/0
KE_CELERY_BROKER_URL=redis://localhost:6379/0
KE_CELERY_RESULT_BACKEND=redis://localhost:6379/1
KE_SECRET_KEY=change-me-in-production
KE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
KE_STORAGE_BACKEND=local
KE_STORAGE_LOCAL_PATH=./data/storage
KE_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
KE_MODULES_DIR=./modules
KE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KE_TASK_SYNC=true
